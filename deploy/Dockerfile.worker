# syntax=docker/dockerfile:1

FROM mcr.microsoft.com/dotnet/sdk:10.0-noble AS build
WORKDIR /src
# .editorconfig carries the analyser configuration, including the suppressions for EF Core's
# generated migrations. Without it the build fails inside the image but not outside it.
COPY global.json .editorconfig Directory.Build.props Directory.Build.targets Directory.Packages.props PriorState.slnx ./
COPY src/ src/
COPY tests/ tests/
RUN dotnet restore src/PriorState.Worker/PriorState.Worker.csproj
RUN dotnet publish src/PriorState.Worker/PriorState.Worker.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/runtime:10.0-noble AS final
WORKDIR /app

# The worker starts browsertrix-crawler containers through the Docker socket. The socket group id
# differs between hosts, so it is passed in at compose time rather than baked in here.
ARG DOCKER_GID=999
RUN apt-get update \
 && apt-get install --no-install-recommends -y git ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 2000 priorstate \
 && useradd --system --uid 2000 --gid priorstate --create-home priorstate \
 && (getent group ${DOCKER_GID} || groupadd --gid ${DOCKER_GID} dockerhost) \
 && usermod -aG $(getent group ${DOCKER_GID} | cut -d: -f1) priorstate \
 && mkdir -p /var/lib/priorstate/crawls /var/lib/priorstate/render /var/lib/priorstate/plugins \
 && chown -R priorstate:priorstate /var/lib/priorstate

COPY --from=build --chown=priorstate:priorstate /app ./
USER priorstate

ENTRYPOINT ["dotnet", "PriorState.Worker.dll"]
