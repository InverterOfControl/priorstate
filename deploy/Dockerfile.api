# syntax=docker/dockerfile:1

# The Vue app is built first and baked into the API image, so the running system is one container
# serving both the API and the interface, and the production compose file needs no Node runtime.
FROM node:26-alpine AS ui
WORKDIR /src/ui
COPY src/ui/package.json src/ui/package-lock.json ./
RUN npm ci
COPY src/ui/ ./
# vite.config.ts writes to ../PriorState.Api/wwwroot, i.e. /src/PriorState.Api/wwwroot here.
RUN npm run build

FROM mcr.microsoft.com/dotnet/sdk:10.0-noble AS build
WORKDIR /src
# .editorconfig carries the analyser configuration, including the suppressions for EF Core's
# generated migrations. Without it the build fails inside the image but not outside it.
COPY global.json .editorconfig Directory.Build.props Directory.Packages.props PriorState.slnx ./
COPY src/ src/
COPY --from=ui /src/PriorState.Api/wwwroot/ src/PriorState.Api/wwwroot/
RUN dotnet restore src/PriorState.Api/PriorState.Api.csproj
RUN dotnet publish src/PriorState.Api/PriorState.Api.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble AS final
WORKDIR /app

# The API renders the evidence protocol by starting a short-lived Chromium container, so like
# the worker it needs to reach the Docker socket. The socket's group id differs between hosts,
# so it is passed in at build time. Find it with:  stat -c '%g' /var/run/docker.sock
ARG DOCKER_GID=999

# curl is here only for the container health check. The API itself makes no outbound calls that
# need it — timestamping goes through HttpClient.
RUN apt-get update \
 && apt-get install --no-install-recommends -y curl \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 2000 priorstate \
 && useradd --system --uid 2000 --gid priorstate --create-home priorstate \
 && (getent group ${DOCKER_GID} || groupadd --gid ${DOCKER_GID} dockerhost) \
 && usermod -aG $(getent group ${DOCKER_GID} | cut -d: -f1) priorstate \
 && mkdir -p /var/lib/priorstate/render /var/lib/priorstate/keys \
 && chown -R priorstate:priorstate /var/lib/priorstate

COPY --from=build --chown=priorstate:priorstate /app ./
USER priorstate

ENV ASPNETCORE_HTTP_PORTS=8080 \
    DOTNET_gcServer=1
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=5 \
  CMD curl --fail --silent http://localhost:8080/health || exit 1

ENTRYPOINT ["dotnet", "PriorState.Api.dll"]
